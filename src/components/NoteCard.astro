---
export interface Props {
  title: string;
  description?: string;
  tags: string[];
  slug: string;
  date: string;
}

const { title, description, tags, slug, date } = Astro.props;
---

<a
  href={`/notes/${slug}`}
  class="wireframe-block p-5 rounded-lg block hover:shadow-lg transition-shadow duration-200 no-underline"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <h3 class="font-handwriting text-2xl text-notebook-blue font-bold mb-1 truncate">
        {title}
      </h3>
      {description && (
        <p class="text-sm text-slate-500 font-sans line-clamp-2">{description}</p>
      )}
    </div>
    <time class="text-xs text-slate-400 font-sans whitespace-nowrap shrink-0">{date}</time>
  </div>
  <div class="flex flex-wrap gap-2 mt-3">
    {tags.map((tag) => (
      <span class="block-label !static !text-[0.65rem]">{tag}</span>
    ))}
  </div>
</a>
