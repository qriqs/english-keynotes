---
export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<div class="mb-6">
  {title && <h3 class="!mt-0 !mb-2 !text-indigo-400">{title}</h3>}
  <div class="handwriting text-gray-800 text-xl pl-4 border-l-4 border-indigo-200 flex flex-col gap-2">
    <slot />
  </div>
</div>
