---
import NotebookLayout from '../layouts/NotebookLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import Search from 'astro-pagefind/components/Search';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('keynotes');

// Sort notes by date descending (most recent first)
allNotes.sort((a, b) => {
  const parseDate = (dateStr) => {
    const [day, month, year] = dateStr.split('|').map((s) => s.trim());
    const fullYear = year.length === 2 ? `20${year}` : year;
    return `${fullYear}${month}${day}`;
  };
  return parseDate(b.data.date).localeCompare(parseDate(a.data.date));
});

const allTags = [...new Set(allNotes.flatMap((note) => note.data.tags))].sort();

const today = new Date().toLocaleDateString('en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: '2-digit'
}).replace(/\//g, ' | ');
---

<NotebookLayout title="Home & Search" ignorePagefind={true}>
  
  <!-- HEADER BLOCK -->
  <div class="wireframe-block p-4 rounded-lg flex flex-col sm:flex-row justify-between items-start sm:items-center">
    <span class="block-label">Header Block (Top 10%)</span>
    <div class="flex items-center gap-2">
      <span class="font-bold text-gray-500 text-sm">DATE:</span>
      <span class="handwriting border-b border-gray-300 w-32 inline-block px-2">{today}</span>
    </div>
    <div class="flex items-center gap-2 mt-2 sm:mt-0 w-full sm:w-auto flex-grow sm:ml-8">
      <span class="font-bold text-gray-500 text-sm">TOPIC:</span>
      <span class="handwriting border-b border-gray-300 w-full inline-block px-2 text-2xl font-bold">Binder Index & Search 🔎</span>
    </div>
  </div>

  <!-- MAIN BODY GRID -->
  <div class="flex-grow flex flex-col md:flex-row gap-6">
    
    <!-- LEFT SIDEBAR (Index & Vocab) -->
    <div class="wireframe-block w-full md:w-[30%] p-4 rounded-lg flex flex-col gap-6 h-fit">
      <span class="block-label">Sidebar (Left 30%)</span>
      
      <!-- Search/Index Box -->
      <div>
        <h3 class="font-bold text-gray-400 text-xs tracking-widest uppercase mb-2 flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          All Tags
        </h3>
        <div class="handwriting text-gray-600 border border-gray-200 rounded p-2 bg-gray-50/50 flex flex-wrap gap-2">
          {allTags.map((tag) => (
            <span class="bg-blue-100 text-blue-800 text-sm px-2 rounded-full leading-tight">{tag}</span>
          ))}
        </div>
      </div>

      <!-- General Info -->
      <div class="flex-grow">
        <h3 class="font-bold text-gray-400 text-xs tracking-widest uppercase mb-2 flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Welcome
        </h3>
        <p class="handwriting text-xl text-gray-700 leading-tight">
          This is your master digital binder. Use the search bar to find any keynote or vocabulary instantly.
        </p>
      </div>
    </div>

    <!-- RIGHT MAIN AREA (Core Documentation) -->
    <div class="wireframe-block w-full md:w-[70%] p-4 sm:p-6 rounded-lg flex flex-col gap-6">
      <span class="block-label">Core Documentation (Right 70%)</span>

      <!-- Search Block -->
      <div>
        <h3 class="font-bold text-indigo-400 text-xs tracking-widest uppercase mb-2">1. Search</h3>
        <div class="bg-indigo-50 border border-indigo-100 rounded-md p-4" id="search-container">
          <Search
            uiOptions={{
              showImages: false,
              excerptLength: 30,
            }}
          />
        </div>
      </div>

      <!-- Notes Index Block -->
      <div>
        <h3 class="font-bold text-indigo-400 text-xs tracking-widest uppercase mb-2">2. All Notes</h3>
        <div class="mt-4 grid grid-cols-1 gap-4">
          {allNotes.map((note) => (
            <NoteCard
              title={note.data.title}
              description={note.data.description}
              tags={note.data.tags}
              slug={note.slug}
              date={note.data.date}
            />
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- ACTION / TO-DO BLOCK -->
  <div class="wireframe-block p-4 rounded-lg bg-red-50/30 mt-auto">
    <span class="block-label">Action / To-Do (Bottom 10%)</span>
    <div class="flex items-start gap-4">
      <div class="mt-1">
        <input type="checkbox" class="w-5 h-5 accent-red-500 rounded border-gray-300" checked readonly>
      </div>
      <div class="handwriting text-xl text-gray-800">
        <strong class="text-red-600">Goal:</strong> Master English Grammar and Vocabulary.
      </div>
    </div>
  </div>

</NotebookLayout>
