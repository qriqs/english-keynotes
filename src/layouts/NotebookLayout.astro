---
import '../styles/notebook.css';

export interface Props {
  title: string;
  ignorePagefind?: boolean;
}

const { title, ignorePagefind = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth" data-pagefind-ignore={ignorePagefind ? "all" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | English Master Binder</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Inter:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-slate-800 flex justify-center items-start min-h-screen p-4 md:p-8 font-sans">
    
    <!-- Main Notebook Page Container -->
    <div class="graph-paper w-full max-w-4xl rounded-r-2xl rounded-l-md shadow-2xl relative overflow-hidden py-10 px-12 md:px-16 mx-auto min-h-[90vh] flex flex-col gap-6 text-slate-800">
      
      <!-- Notebook specific decorations -->
      <div class="binding-holes">
          {Array.from({ length: 25 }).map(() => <div class="hole"></div>)}
      </div>

      <!-- Page Content -->
      <div class="relative z-10 flex flex-col flex-grow gap-6">
        <slot />
      </div>

    </div>
  </body>
</html>
